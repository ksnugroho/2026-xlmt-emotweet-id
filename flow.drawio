        <mxCell id="10" value="&lt;b&gt;Pre-trained Language Model&lt;/b&gt;&lt;br&gt;&lt;i&gt;XLM-T&lt;/i&gt; (278M) | &lt;i&gt;Indo-RoBERTa&lt;/i&gt; (125M)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=CMU Serif;fontSize=11;" vertex="1" parent="1">
