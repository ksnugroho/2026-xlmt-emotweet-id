        <mxCell id="14" value="&lt;b&gt;Baseline (tanpa DAPT)&lt;/b&gt;&lt;br&gt;&lt;i&gt;XLM-T-E1 | IR-E1 | MB-E1&lt;/i&gt;&lt;br&gt;PLM orisinal tanpa adaptasi domain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontFamily=CMU Serif;fontSize=11;" vertex="1" parent="1">
